@model vmWarehouse
@{
    ViewData["Title"] = "AddWarehouse";
    Layout = "~/Views/Shared/_Menu.cshtml";
}

<!-- Page Wrapper -->
<div class="page-wrapper">
	<div class="content container-fluid">

		<!-- Page Header -->
		<div class="page-header">
			<div class="row align-items-center">
				<div class="col">
					 @if ((bool)ViewData["isEdit"] == false) 
					{
						<h3 class="page-title">Add Warehouse</h3>
					}
					else
					{
						<h3 class="page-title">Edit Warehouse</h3>
					} 

				</div>
			</div>
		</div>
		<!-- /Page Header -->

		<div class="row">
			<div class="col-sm-12">

				<div class="card">
					<div class="card-body">
						<form method="post">
							<div class="row">
								<div class="col-12">
									<h5 class="form-title"><span>Warehouse Information</span></h5>
								</div>
								<div class="col-12 col-sm-4">
									<div class="form-group local-forms">
										<input type="hidden" asp-for="warehouseDTO.Id"  class="form-control">
									</div>
								</div>
								<div class="col-12 col-sm-4">
									<div class="form-group local-forms">
										<label>Warehouse Name <span class="login-danger">*</span></label>
										<input asp-for="warehouseDTO.Name" type="text" class="form-control">
										<span asp-validation-for="warehouseDTO.Name" class="text-danger small"></span>
									</div>
								</div>
								<div class="col-12 col-sm-4">
									<div class="form-group local-forms">
										<label>Description: <span class="login-danger">*</span></label>
										<textarea asp-for="warehouseDTO.Description" class="form-control" rows="4"></textarea>
										<span asp-validation-for="warehouseDTO.Description" class="text-danger small"></span>
									</div>
								</div>

								<div class="col-12 col-sm-4">
									<div class="form-group local-forms">
										<label>Country <span class="login-danger">*</span></label>
										<select id="countrySelect" onchange="GetCities()" class="form-control select">
											<option value="">Select Country</option>
											@foreach(CountryDTO country in Model.countries)
											{
												<option value="@country.Id">@country.Name</option>
											}

										</select>
										<span  class="text-danger small"></span>
									</div>
								</div>
								<div class="col-12 col-sm-4">
									<div class="form-group local-forms">
										<label>City <span class="login-danger">*</span></label>
										<select asp-for="warehouseDTO.City_Id" id="citySelect" class="form-control select">
											<option value="">Select City</option>
											@foreach (CityDTO city in Model.cities)
											{
												<option value="@city.Id"
														data-country="@city.Country_Id">
													@city.Name </option>
											}

										</select>
										<span asp-validation-for="warehouseDTO.City_Id" class="text-danger small"></span>
									</div>
								</div>

								<div class="col-12">
									 @if ((bool)ViewData["isEdit"] == false) 
									{
										<div class="student-submit">
											<button type="submit" asp-action="CreateWarehouse" class="btn btn-primary">Create Warehouse </button>
										</div>
									}
									else
									{
										<div class="student-submit">
											<button type="submit" asp-action="UpdateWarehouse" class="btn btn-primary">Update</button>
										</div>
									} 

								</div>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- /Page Wrapper -->

<script>

	function GetCities()
	{
		var countryId= document.getElementById("countrySelect").value;

		var citySelect= document.getElementById("citySelect");

		for(var i=1; i<citySelect.options.length; i++)
		{
			var city= citySelect.options[i];

			if(city.getAttribute("data-country")==countryId)
			{
				city.hidden=false;
			}
			else
			{
				city.hidden=true;
			}
		}
		citySelect.value="";
	}

</script>