@model List<CityDTO>
@{
    ViewData["Title"] = "CityList";
    Layout = "~/Views/Shared/_Menu.cshtml";
}

<!-- Page Header -->
<div class="page-header">
    <div class="row">
        <div class="col-sm-12">
            <div class="page-sub-header">
                <h3 class="page-title">Cities</h3>
            </div>
        </div>
    </div>
</div>
<!-- /Page Header -->

<form method="post">
    <div class="student-group-form">
        <div class="row">
            <div class="col-lg-3 col-md-6">
                <div class="form-group">
                    <input type="text" name="txtName" class="form-control" placeholder="Search by Name ...">
                </div>
            </div>

            <div class="col-lg-2">
                <div class="search-student-btn">
                    <input type="submit" asp-action="GetCity" class="btn btn-primary" value="Search" />
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">

            <div class="card card-table comman-shadow">
                <div class="card-body">

                    <!-- Page Header -->

                    <div class="page-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h3 class="page-title">Cities</h3>
                            </div>
                            <div class="col-auto text-end float-end ms-auto download-grp">
                                <a asp-action="AddCity" class="btn btn-primary"><i class="fas fa-plus"></i></a>
                            </div>
                        </div>
                    </div>
                    <!-- /Page Header -->

                    <div class="table-responsive">
                        <table class="table border-0 star-student table-hover table-center mb-0 table-striped">
                            <thead class="student-thread">
                                <tr>
                                    <th>City Name</th>

                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (CityDTO city in Model)
                                {
                                    <tr>
                                        <td>
                                            <h2 class="table-avatar">
                                                <a href="student-details.html">@city.Name</a>
                                            </h2>
                                        </td>
                                        <td class="text-end">
                                            <div class="actions ">
                                                <a asp-route-CityId="@city.Id"
                                                   asp-action="Delete"
                                                   class="btn btn-sm bg-danger-light me-2">
                                                    <i class="feather-trash-2"></i>
                                                </a>
                                                <a asp-action="Edit"
                                                   asp-route-CityId="@city.Id"
                                                   class="btn btn-sm bg-danger-light">
                                                    <i class="feather-edit"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>